# ============================================================
# Backend - Variables de entorno (copiar a .env)
#   cp .env.example .env
# ============================================================

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vetcare_db

# Clave usada para firmar los tokens JWT (cambiar en producción)
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Minutos de validez del access token
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Algoritmo de firma JWT
ALGORITHM=HS256