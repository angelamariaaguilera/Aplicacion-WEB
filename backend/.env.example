# ============================================================
# Backend - Variables de entorno (copiar a .env)
#   cp .env.example .env
# ============================================================

# Cadena de conexión a PostgreSQL.
#
# Supabase: panel > Connect > Connection string > URI > "Session pooler".
#   - El usuario es postgres.<PROJECT_REF>, no solo postgres.
#   - Codifica los caracteres especiales de la clave (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:5432/postgres
#
# PostgreSQL local (alternativa):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vetcare_db

# Modo SSL. Supabase: require. PostgreSQL local: déjalo vacío o en prefer.
DATABASE_SSLMODE=require

# Clave usada para firmar los tokens JWT (cambiar en producción)
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Minutos de validez del access token
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Algoritmo de firma JWT
ALGORITHM=HS256
